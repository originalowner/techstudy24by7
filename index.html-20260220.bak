      <script>
fetch('data.json')
  .then(response => response.json())
  .then(posts => {
    const container = document.getElementById('blog-container');
    container.innerHTML = '';

    posts.forEach(post => {
      const blogItem = `
        <div class="w-dyn-item">
          <a href="${post.url}" class="articles-block w-inline-block">
            <div>
              <img src="${post.image}" alt="${post.title}" class="article-thumbnail"/>
              <h3 class="blog-title">${post.title}</h3>
            </div>
            <p class="process_card-description">${post.excerpt}</p>
            <p class="a-read-more">Read more ></p>
          </a>
        </div>
      `;
      container.innerHTML += blogItem;
    });
  })
  .catch(error => console.error('Error loading JSON:', error));
</script>
<script>
fetch('data.json')
  .then(response => response.json())
  .then(posts => {

    const featuredContainer = document.getElementById('featured-post');
    const latestContainer = document.getElementById('latest-posts');

    featuredContainer.innerHTML = '';
    latestContainer.innerHTML = '';

    // SORT POSTS BY DATE (Newest First)
    posts.sort((a, b) => new Date(b.date) - new Date(a.date));

    posts.forEach((post, index) => {

      // FEATURED POST
      if (post.featured === true) {
        featuredContainer.innerHTML = `
          <a href="${post.url}" class="blog-item w-inline-block">
            <div class="blog-image-wrap">
              <img src="${post.image}" alt="${post.title}" class="blog-image"/>
            </div>
            <div class="blog-content">
              <h3 class="heading-h2">${post.title}</h3>
              <p class="paragraph-detials-medium">${post.excerpt}</p>
              <div class="profile-block-2">
                <div class="normal-wrapper">
                  <div class="title-small">${post.author}</div>
                  <p class="paragraph-detials-small-copy">${post.date}</p>
                </div>
              </div>
            </div>
          </a>
        `;
      }

      // LATEST POSTS (skip featured)
      if (!post.featured && index < 4) {
        latestContainer.innerHTML += `
          <div class="w-dyn-item">
            <a href="${post.url}" class="articles-block w-inline-block">
              <img src="${post.image}" alt="${post.title}" class="article-thumbnail"/>
              <h3 class="blog-title">${post.title}</h3>
              <p class="process_card-description">${post.excerpt}</p>
              <p class="a-read-more">Read more ></p>
            </a>
          </div>
        `;
      }

    });

  })
  .catch(error => console.error('Error loading blog data:', error));
</script>
   </body>
</html>
